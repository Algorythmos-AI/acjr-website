---
import { content } from '../content';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const facts = content[Astro.props.lang].facts;
---

<ul class="fact-strip">
  {
    facts.map((f) => (
      <li>
        <strong>{f.value}</strong>
        <span>{f.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .fact-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--charcoal);
    color: var(--white);
    border-top: var(--rule);
  }
  @media (min-width: 768px) {
    .fact-strip { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .fact-strip li {
    margin: 0;
    padding: var(--space-3);
    border-inline-end: 1px solid rgb(255 255 255 / 0.15);
    border-bottom: 1px solid rgb(255 255 255 / 0.15);
  }
  .fact-strip strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    line-height: 1.2;
    color: var(--ochre-500);
  }
  :global(:lang(ar)) .fact-strip strong { font-family: var(--font-ar-serif); }
  .fact-strip span { font-size: var(--fs-small); color: rgb(255 255 255 / 0.9); }
</style>
