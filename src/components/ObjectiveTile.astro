---
import ObjectiveIcon from './ObjectiveIcon.astro';
import Icon from './Icon.astro';
import type { Objective } from '../content/types';

interface Props {
  objective: Objective;
  index: number;
  href: string;
  cta: string;
}

const { objective, index, href, cta } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article class="tile" data-index={index}>
  <div class="tile-top">
    <span class="tile-number" aria-hidden="true">{number}</span>
    <ObjectiveIcon id={objective.id} />
  </div>
  <h3>
    <a href={href}>{objective.title}</a>
  </h3>
  <p>{objective.short}</p>
  <span class="tile-more" aria-hidden="true">{cta}<Icon name="arrow" size={18} flip /></span>
</article>

<style>
  .tile {
    --stripe: var(--blue-700);
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-3);
    background: var(--white);
    border: 1px solid var(--grey-200);
    border-top: 6px solid var(--stripe);
    transition: box-shadow 0.15s, transform 0.15s;
  }
  .tile[data-index='1'] { --stripe: var(--navy-800); }
  .tile[data-index='2'] { --stripe: var(--ochre-700); }
  .tile[data-index='3'] { --stripe: var(--blue-800); }
  .tile[data-index='4'] { --stripe: var(--charcoal); }
  .tile[data-index='5'] { --stripe: var(--ochre-700); }
  .tile:hover { box-shadow: var(--shadow); }
  @media (prefers-reduced-motion: no-preference) {
    .tile:hover { transform: translateY(-2px); }
  }
  .tile:focus-within { outline: 3px solid var(--blue-700); outline-offset: 2px; }
  .tile-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-2); color: var(--stripe); }
  .tile-number { font: 900 2rem/1 var(--font-serif); color: var(--stripe); }
  .tile h3 { font-size: 1.25rem; }
  .tile h3 a { color: var(--navy-900); text-decoration: none; }
  /* Whole tile is clickable through the heading link. */
  .tile h3 a::after { content: ''; position: absolute; inset: 0; }
  .tile h3 a:focus-visible { outline: none; box-shadow: none; }
  .tile p { color: var(--grey-600); flex-grow: 1; }
  .tile-more { display: inline-flex; align-items: center; gap: 0.375rem; font-weight: 700; color: var(--blue-700); font-size: 1rem; }
</style>
