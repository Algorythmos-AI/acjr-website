---
import ObjectiveIcon from './ObjectiveIcon.astro';
import Icon from './Icon.astro';
import ArtRef from './ArtRef.astro';
import type { Objective } from '../content/types';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  objective: Objective;
  /** Position in Art. 6 of the statutes, from 0. */
  index: number;
  href: string;
  cta: string;
}

const { lang, objective, index, href, cta } = Astro.props;
---

<article class="tile reveal">
  <div class="tile-top">
    <ObjectiveIcon id={objective.id} />
    <ArtRef lang={lang} article={`6.${index + 1}`} />
  </div>
  <h3>
    <a href={href}>{objective.title}</a>
  </h3>
  <p>{objective.short}</p>
  <span class="tile-more" aria-hidden="true">{cta}<Icon name="arrow" size={18} flip /></span>
</article>

<style>
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-3);
    background: var(--white);
    border: 1px solid var(--grey-200);
    border-top: var(--rule);
    transition: box-shadow var(--dur-2) var(--ease-out), transform var(--dur-2) var(--ease-out);
  }
  .tile:hover { box-shadow: var(--shadow-3); }
  @media (prefers-reduced-motion: no-preference) {
    .tile:hover { transform: translateY(-3px); }
  }
  .tile:focus-within { outline: 3px solid var(--blue-700); outline-offset: 2px; }
  .tile-top { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-bottom: var(--space-2); color: var(--blue-700); }
  .tile h3 { font-size: 1.25rem; }
  .tile h3 a { color: var(--navy-900); text-decoration: none; }
  /* Whole tile is clickable through the heading link. */
  .tile h3 a::after { content: ''; position: absolute; inset: 0; }
  .tile h3 a:focus-visible { outline: none; box-shadow: none; }
  .tile p { color: var(--grey-600); flex-grow: 1; }
  .tile-more { display: inline-flex; align-items: center; gap: 0.375rem; font-weight: 700; color: var(--blue-700); font-size: 1rem; }
</style>
