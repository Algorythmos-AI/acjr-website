---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Illo from './Illo.astro';
import { photos } from '../config/photos';
import type { Lang } from '../i18n/routes';

/**
 * A visual slot that is ready for photography. Today it renders a line illustration; once
 * src/assets/photos/<photo>.jpg exists (and is registered in src/config/photos.ts), it renders
 * that photo instead, optimised by astro:assets and given the shared navy duotone treatment.
 */
interface Props {
  lang: Lang;
  /** Key of the photo that will replace the illustration when it exists. */
  photo: string;
  illo: Parameters<typeof Illo>[0]['name'];
  /** Rendered width of the photo, for the responsive `sizes` attribute. */
  sizes?: string;
  class?: string;
}

const { lang, photo, illo, sizes = '(min-width: 1024px) 40vw, 100vw', class: className } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const file = Object.entries(files).find(([path]) => path.replace(/^.*\/|\.\w+$/g, '') === photo)?.[1];
const meta = photos[photo];
if (file && !meta) throw new Error(`Photo "${photo}" has no entry in src/config/photos.ts (alt text in every language).`);
---

{
  file && meta ? (
    <figure class:list={['media media--photo', className]}>
      <Picture src={file.default} alt={meta.alt[lang]} widths={[480, 800, 1200]} sizes={sizes} formats={['avif', 'webp']} loading="lazy" />
    </figure>
  ) : (
    <div class:list={['media media--illo', className]}>
      <Illo name={illo} />
    </div>
  )
}

<style>
  .media { margin: 0; }
  .media--photo { position: relative; overflow: hidden; background: var(--navy-900); }
  .media--photo :global(picture) { display: block; height: 100%; }
  .media--photo :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); mix-blend-mode: luminosity; }
  /* One duotone for every photo, so the set reads as a family. */
  .media--photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(160deg, rgb(0 112 173 / 0.45), rgb(11 37 69 / 0.55)); mix-blend-mode: multiply; pointer-events: none; }
</style>
