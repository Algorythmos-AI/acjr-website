---
import type { ObjectiveId } from '../content/types';

/** Pictograms for the six objectives, drawn on a 48px grid in the logo's line style. */
interface Props {
  id: ObjectiveId;
  size?: number;
}

const paths: Record<ObjectiveId, string> = {
  // Clipboard with magnifier: documentation
  documentation:
    '<path d="M30 8h4a3 3 0 0 1 3 3v8"/><path d="M18 8h-4a3 3 0 0 0-3 3v28a3 3 0 0 0 3 3h12"/><rect x="18" y="5" width="12" height="6" rx="2"/><path d="M17 20h12"/><path d="M17 27h7"/><circle cx="34" cy="32" r="6"/><path d="m38.5 36.5 4.5 4.5"/>',
  // Scale of justice: legal analysis and litigation
  litigation:
    '<path d="M24 6v34"/><path d="M15 42h18"/><path d="M8 13h32"/><circle cx="24" cy="9" r="2.5"/><path d="m12 13-6 13h12Z"/><path d="M6 26a6 6 0 0 0 12 0"/><path d="m36 13-6 13h12Z"/><path d="M30 26a6 6 0 0 0 12 0"/>',
  // Bridge: transitional justice
  transitional:
    '<path d="M4 34h40"/><path d="M4 24c8 0 12-10 20-10s12 10 20 10"/><path d="M12 22v12"/><path d="M24 14v20"/><path d="M36 22v12"/><path d="M8 40h32"/>',
  // Shield with person: defenders
  defenders:
    '<path d="M24 44s14-7 14-18V12L24 6 10 12v14c0 11 14 18 14 18Z"/><circle cx="24" cy="20" r="4"/><path d="M17 33a7 7 0 0 1 14 0"/>',
  // Sheltering hands over people: vulnerable groups
  vulnerable:
    '<circle cx="18" cy="20" r="4"/><circle cx="31" cy="22" r="3"/><path d="M11 33a7 7 0 0 1 14 0"/><path d="M26 33a5 5 0 0 1 10 0"/><path d="M6 30V18a6 6 0 0 1 6-6"/><path d="M42 30V18a6 6 0 0 0-6-6"/><path d="M6 38h36"/>',
  // Open book: research and training
  research:
    '<path d="M24 14c-4-4-10-5-18-5v28c8 0 14 1 18 5"/><path d="M24 14c4-4 10-5 18-5v28c-8 0-14 1-18 5"/><path d="M24 14v28"/><path d="M11 17c3 0 6 .5 8 1.5"/><path d="M11 23c3 0 6 .5 8 1.5"/><path d="M37 17c-3 0-6 .5-8 1.5"/><path d="M37 23c-3 0-6 .5-8 1.5"/>',
};

const { id, size = 48 } = Astro.props;
---

<svg
  class="objective-icon"
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[id]}
/>
