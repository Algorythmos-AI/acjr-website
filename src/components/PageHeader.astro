---
import Illo from './Illo.astro';
import { breadcrumbs } from '../i18n/nav';
import { ui } from '../i18n/ui';
import { content } from '../content';
import type { Lang, PageKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  pageKey: PageKey;
  /** Overrides for pages below a section page, e.g. a news article. */
  title?: string;
  lead?: string;
  /** When set, the section page becomes a link and this is the current crumb. */
  currentCrumb?: string;
}

const { lang, pageKey, title, lead, currentCrumb } = Astro.props;
const meta = content[lang].meta[pageKey];
const trail = breadcrumbs(lang, pageKey).map((c) => ({ ...c, current: false }));
if (currentCrumb) trail.push({ key: pageKey, label: currentCrumb, href: '', current: true });
else trail[trail.length - 1]!.current = true;
// One line illustration per section, shown beside the heading on wide screens. None for legal pages.
const illos: Partial<Record<PageKey, Parameters<typeof Illo>[0]['name']>> = {
  about: 'africa',
  principles: 'scales',
  framework: 'book',
  work: 'dossier',
  advocacy: 'table',
  governance: 'columns',
  transparency: 'shield',
  involved: 'network',
  contact: 'shield',
  news: 'dossier',
};
const illo = illos[pageKey];
const heading = title ?? meta.title;
const leadText = lead ?? meta.lead;
---

<div class="page-header on-dark">
  <div class="container page-header-inner">
    <div class="page-header-text">
    <nav class="breadcrumbs" aria-label={ui[lang].breadcrumb}>
      <ol>
        {
          trail.map((crumb) =>
            crumb.current ? (
              <li aria-current="page">{crumb.label}</li>
            ) : (
              <li>
                <a href={crumb.href}>{crumb.label}</a>
              </li>
            ),
          )
        }
      </ol>
    </nav>
    <h1 class:list={{ long: heading.length > 60 }}>{heading}</h1>
    <hr class="rule-ochre" />
    {leadText && <p class="page-lead">{leadText}</p>}
    <slot />
    </div>
    {illo && <div class="page-header-art"><Illo name={illo} /></div>}
  </div>
</div>

<style>
  .page-header {
    background:
      radial-gradient(120% 140% at 100% 0%, rgb(0 158 219 / 0.22), transparent 55%),
      var(--navy-900);
    color: var(--white);
    padding-block: var(--space-3) var(--space-5);
  }
  :global([dir='rtl']) .page-header {
    background:
      radial-gradient(120% 140% at 0% 0%, rgb(0 158 219 / 0.22), transparent 55%),
      var(--navy-900);
  }
  .page-header-inner { display: grid; gap: var(--space-4); align-items: end; }
  .page-header-art { display: none; }
  @media (min-width: 1024px) {
    .page-header-inner { grid-template-columns: minmax(0, 1fr) 15rem; }
    .page-header-art { display: block; opacity: 0.85; }
  }
  .page-header h1 { color: var(--white); margin-top: var(--space-4); max-width: 22ch; }
  .page-header h1.long { font-size: var(--fs-h2); max-width: 32ch; }
  .page-header .rule-ochre { margin-bottom: var(--space-2); }
  .page-lead { font-size: var(--fs-lead); max-width: 46rem; margin: 0; color: rgb(255 255 255 / 0.9); }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-small);
    color: rgb(255 255 255 / 0.85);
  }
  .breadcrumbs li { margin: 0; }
  .breadcrumbs li + li::before {
    content: '/';
    margin-inline: 0.5rem;
    color: rgb(255 255 255 / 0.5);
  }
  .breadcrumbs a { color: var(--link-on-dark); }
  .breadcrumbs a:hover { color: var(--white); }
</style>
