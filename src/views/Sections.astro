---
import WithToc from '../components/WithToc.astro';
import type { Lang } from '../i18n/routes';

/** Plain sectioned text page, used for the legal notice and the privacy policy. */
interface Props {
  lang: Lang;
  sections: { title: string; body: string[] }[];
  updated?: string;
}

const { lang, sections, updated } = Astro.props;
const id = (i: number) => `section-${i + 1}`;
---

<div class="page-body">
  <div class="container">
    <WithToc lang={lang} items={sections.map((s, i) => ({ id: id(i), label: s.title }))}>
      <div class="prose">
        {updated && <p class="updated">{updated}</p>}
        {
          sections.map((s, i) => (
            <section aria-labelledby={id(i)}>
              <h2 id={id(i)}>{s.title}</h2>
              {s.body.map((p) => <p>{p}</p>)}
            </section>
          ))
        }
      </div>
    </WithToc>
  </div>
</div>

<style>
  section + section { margin-top: var(--space-4); }
  h2 { font-size: var(--fs-h3); }
  .updated { color: var(--grey-600); font-size: var(--fs-small); }
</style>
