---
import ArtRef from '../components/ArtRef.astro';
import OrgChart from '../components/OrgChart.astro';
import WithToc from '../components/WithToc.astro';
import { content } from '../content';
import { pagePath, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = content[lang];
const g = c.governance;
// Names are written FAMILY NAME Given name, as in the statutes. Initials are given then family,
// skipping short particles such as "EL" (EL TAHER AISSA Issam → IT).
const initials = (name: string) => {
  const words = name.split(/\s+/);
  const given = words.find((w) => w !== w.toUpperCase()) ?? words[words.length - 1]!;
  const family = words.find((w) => w === w.toUpperCase() && w.length > 2) ?? words[0]!;
  return `${given[0]}${family[0]}`;
};
const toc = [
  { id: 'bureau-title', label: g.bureauTitle },
  { id: 'bodies-title', label: g.bodiesTitle },
  { id: 'volunteer-title', label: g.volunteerTitle },
  { id: 'statutes-title', label: g.statutesTitle },
];
---

<!-- Art. 11–15: governance -->
<div class="page-body">
  <div class="container">
    <WithToc lang={lang} items={toc}>
    <div class="prose">{g.intro.map((p) => <p class="lead">{p}</p>)}</div>

    <section class="block" aria-labelledby="bureau-title">
      <ArtRef lang={lang} article="14" />
      <h2 id="bureau-title">{g.bureauTitle}</h2>
      <p>{g.bureauLead}</p>
      <ul class="bureau grid grid--3 plain-list">
        {
          g.bureau.map((m) => (
            <li class="person">
              <span class="person-avatar" aria-hidden="true" lang="fr">{initials(m.name)}</span>
              <p class="person-name" dir="ltr" lang="fr">{m.name}</p>
              <p class="person-role">{m.role}</p>
              <p class="person-duty">{m.duty}</p>
            </li>
          ))
        }
      </ul>
      <p class="note bureau-note">{g.bureauNote}</p>
    </section>

    <section class="block" aria-labelledby="bodies-title">
      <ArtRef lang={lang} article="11–14" />
      <h2 id="bodies-title">{g.bodiesTitle}</h2>
      <OrgChart lang={lang} />
      <ul class="grid grid--2 plain-list">
        {
          g.bodies.map((b) => (
            <li>
              <div class="card">
                <h3>{b.title}</h3>
                <p>{b.text}</p>
                <ul class="facts">{b.facts.map((f) => <li>{f}</li>)}</ul>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="grid grid--2 block">
      <section aria-labelledby="volunteer-title" class="prose">
        <ArtRef lang={lang} article="15" />
        <h2 id="volunteer-title">{g.volunteerTitle}</h2>
        {g.volunteer.map((p) => <p>{p}</p>)}
        <p><a href={pagePath(lang, 'transparency')}>{c.nav.transparency}</a></p>
      </section>
      <section aria-labelledby="statutes-title" class="aside-box">
        <h2 id="statutes-title">{g.statutesTitle}</h2>
        <ul class="checklist">{g.statutes.map((s) => <li>{s}</li>)}</ul>
        <p class="note">{g.statutesNote} <a href={pagePath(lang, 'contact')}>{c.nav.contact}</a></p>
      </section>
    </div>
    </WithToc>
  </div>
</div>

<style>
  .block { margin-block: var(--space-5); }
  .block :global(.art-ref) { margin-bottom: var(--space-1); }
  .person { padding: var(--space-3); border: 1px solid var(--grey-200); border-top: var(--rule); text-align: center; }
  .person-avatar { display: inline-grid; place-items: center; width: 4.5rem; height: 4.5rem; margin-bottom: var(--space-2); border-radius: 50%; background: var(--navy-900); color: var(--white); font: 700 1.375rem/1 var(--font-serif); letter-spacing: 0.04em; border: 3px solid var(--ochre-500); }
  .person-name { margin: 0; font: 700 1.125rem/1.4 var(--font-serif); color: var(--navy-900); unicode-bidi: isolate; }
  .person-role { margin: 0; color: var(--blue-700); font-weight: 700; }
  .person-duty { margin: var(--space-1) 0 0; color: var(--grey-600); font-size: 1rem; }
  .bureau-note { margin-top: var(--space-2); }
  .facts { display: flex; flex-wrap: wrap; gap: var(--space-1); list-style: none; padding: 0; margin: var(--space-2) 0 0; }
  .facts li { margin: 0; padding: 0.25rem 0.625rem; background: var(--blue-50); color: var(--navy-900); font-size: var(--fs-small); font-weight: 500; }
  .note { font-size: var(--fs-small); color: var(--grey-600); margin: 0; }
</style>
