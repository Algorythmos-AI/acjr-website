---
import ArtRef from '../components/ArtRef.astro';
import OrgChart from '../components/OrgChart.astro';
import WithToc from '../components/WithToc.astro';
import { content } from '../content';
import { pagePath, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = content[lang];
const g = c.governance;
const toc = [
  { id: 'bodies-title', label: g.bodiesTitle },
  { id: 'volunteer-title', label: g.volunteerTitle },
  { id: 'statutes-title', label: g.statutesTitle },
];
---

<!-- Art. 11–15: governance -->
<div class="page-body">
  <div class="container">
    <WithToc lang={lang} items={toc}>
    <div class="prose">{g.intro.map((p) => <p class="lead">{p}</p>)}</div>

    <section class="block" aria-labelledby="bodies-title">
      <ArtRef lang={lang} article="11–14" />
      <h2 id="bodies-title">{g.bodiesTitle}</h2>
      <OrgChart lang={lang} />
      <ul class="grid grid--2 plain-list">
        {
          g.bodies.map((b) => (
            <li>
              <div class="card">
                <h3>{b.title}</h3>
                <p>{b.text}</p>
                <ul class="facts">{b.facts.map((f) => <li>{f}</li>)}</ul>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="grid grid--2 block">
      <section aria-labelledby="volunteer-title" class="prose">
        <ArtRef lang={lang} article="15" />
        <h2 id="volunteer-title">{g.volunteerTitle}</h2>
        {g.volunteer.map((p) => <p>{p}</p>)}
        <p><a href={pagePath(lang, 'transparency')}>{c.nav.transparency}</a></p>
      </section>
      <section aria-labelledby="statutes-title" class="aside-box">
        <h2 id="statutes-title">{g.statutesTitle}</h2>
        <ul class="checklist">{g.statutes.map((s) => <li>{s}</li>)}</ul>
        <p class="note">{g.statutesNote} <a href={pagePath(lang, 'contact')}>{c.nav.contact}</a></p>
      </section>
    </div>
    </WithToc>
  </div>
</div>

<style>
  .block { margin-block: var(--space-5); }
  .block :global(.art-ref) { margin-bottom: var(--space-1); }
  .facts { display: flex; flex-wrap: wrap; gap: var(--space-1); list-style: none; padding: 0; margin: var(--space-2) 0 0; }
  .facts li { margin: 0; padding: 0.25rem 0.625rem; background: var(--blue-50); color: var(--navy-900); font-size: var(--fs-small); font-weight: 500; }
  .note { font-size: var(--fs-small); color: var(--grey-600); margin: 0; }
</style>
