---
import Icon from '../components/Icon.astro';
import NewsCard from '../components/NewsCard.astro';
import { content } from '../content';
import { ui } from '../i18n/ui';
import { pagePath, type Lang } from '../i18n/routes';
import { newsPagePath, type Article } from '../lib/news';

interface Props {
  lang: Lang;
  articles: Article[];
  page: number;
  totalPages: number;
}

const { lang, articles, page, totalPages } = Astro.props;
const c = content[lang];
const n = c.news;
const t = ui[lang];
---

<div class="page-body">
  <div class="container">
    {
      articles.length === 0 ? (
        <div class="empty">
          <Icon name="doc" size={40} />
          <h2>{n.emptyTitle}</h2>
          <p>{n.emptyText}</p>
          <p>{n.followText}</p>
          <a class="btn" href={pagePath(lang, 'contact')}>{c.nav.contact}</a>
        </div>
      ) : (
        <>
          <h2 class="visually-hidden">{t.pageOf.replace('{n}', String(page)).replace('{total}', String(totalPages))}</h2>
          <ul class="grid grid--3 plain-list">
            {articles.map((a) => (
              <li>
                <NewsCard article={a} lang={lang} />
              </li>
            ))}
          </ul>
          {totalPages > 1 && (
            <nav class="pager" aria-label={t.pagination}>
              {page > 1 ? (
                <a class="btn btn--ghost" href={newsPagePath(lang, page - 1)} rel="prev">
                  <Icon name="arrow" size={18} class="pager-back" flip />
                  {t.previous}
                </a>
              ) : (
                <span />
              )}
              <p>{t.pageOf.replace('{n}', String(page)).replace('{total}', String(totalPages))}</p>
              {page < totalPages ? (
                <a class="btn btn--ghost" href={newsPagePath(lang, page + 1)} rel="next">
                  {t.next}
                  <Icon name="arrow" size={18} flip />
                </a>
              ) : (
                <span />
              )}
            </nav>
          )}
        </>
      )
    }
  </div>
</div>

<style>
  .empty { max-width: 40rem; margin-inline: auto; padding: var(--space-5) var(--space-3); text-align: center; background: var(--grey-50); border-top: var(--rule); }
  .empty :global(.icon) { margin: 0 auto var(--space-2); color: var(--blue-700); }
  .empty h2 { font-size: var(--fs-h3); }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-2); margin-top: var(--space-5); }
  .pager p { margin: 0; color: var(--grey-600); }
  .pager a:last-child { justify-self: end; }
  .pager :global(.pager-back) { rotate: 180deg; }
</style>
