---
import Icon from '../components/Icon.astro';
import { content } from '../content';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = content[lang].advocacy;
---

<!-- Art. 7 (UN system) and Art. 8 (African system, international courts) -->
<div class="page-body">
  <div class="container">
    <div class="prose">{a.intro.map((p) => <p class="lead">{p}</p>)}</div>

    <section class="block" aria-labelledby="un-title">
      <div class="section-head">
        <h2 id="un-title">{a.unTitle}</h2>
        <p>{a.unLead}</p>
      </div>
      <ul class="grid grid--4 plain-list">
        {a.un.map((m) => (<li><div class="card"><h3>{m.title}</h3><p>{m.text}</p></div></li>))}
      </ul>
    </section>

    <section class="block" aria-labelledby="africa-title">
      <div class="section-head">
        <h2 id="africa-title">{a.africaTitle}</h2>
        <p>{a.africaLead}</p>
      </div>
      <ul class="grid grid--3 plain-list">
        {a.africa.map((m) => (<li><div class="card card--ochre"><h3>{m.title}</h3><p>{m.text}</p></div></li>))}
      </ul>
    </section>

    <section class="block prose" aria-labelledby="networks-title">
      <h2 id="networks-title">{a.networksTitle}</h2>
      {a.networks.map((p) => <p>{p}</p>)}
    </section>

    <div class="notice prose">
      <Icon name="shield" size={22} />
      <p>{a.note}</p>
    </div>
  </div>
</div>

<style>
  .block { margin-block: var(--space-5); }
  .card--ochre { border-top-color: var(--ochre-500); }
</style>
