---
import { content } from '../content';
import { ui } from '../i18n/ui';
import { pageKeys, pagePath, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = content[lang];
const t = ui[lang];
// The fallback list: every page in this language, so the page is useful even without search.
const allPages = pageKeys.filter((k) => k !== 'search');
---

<div class="page-body">
  <div class="container search-page">
    <form class="search-form" role="search" action={pagePath(lang, 'search')} method="get">
      <label for="search-q">{t.searchLabel}</label>
      <div class="search-row">
        <input id="search-q" name="q" type="search" autocomplete="off" spellcheck="false" />
        <button class="btn" type="submit">{t.searchSubmit}</button>
      </div>
    </form>

    <noscript><p class="notice">{t.searchNoJs}</p></noscript>
    <p
      class="search-status"
      role="status"
      aria-live="polite"
      data-results={t.searchResults}
      data-none={t.searchNone}
      data-error={t.searchError}
    ></p>
    <ol class="search-results plain-list"></ol>

    <section class="all-pages" aria-labelledby="all-pages-title">
      <h2 id="all-pages-title">{t.searchAllPages}</h2>
      <ul class="plain-list">
        {allPages.map((k) => <li><a href={pagePath(lang, k)}>{c.nav[k]}</a></li>)}
      </ul>
    </section>
  </div>
</div>

<script>
  // Self-hosted Pagefind: the index for this page's language is built after `astro build`
  // (see package.json). Results are rebuilt from text nodes, never inserted as HTML.
  type Result = { url: string; meta: { title?: string }; excerpt: string };
  type Pagefind = { search(q: string): Promise<{ results: { data(): Promise<Result> }[] }>; options(o: object): Promise<void> };

  const form = document.querySelector<HTMLFormElement>('.search-form');
  const input = document.querySelector<HTMLInputElement>('#search-q');
  const status = document.querySelector<HTMLElement>('.search-status');
  const list = document.querySelector<HTMLOListElement>('.search-results');
  let pagefind: Promise<Pagefind> | undefined;
  let latest = 0;

  // The index is built with straight apostrophes (scripts/build-search-index.mjs); show the site's ’.
  const curly = (text: string) => text.replaceAll("'", '’');

  /** Pagefind marks matches with <mark>; keep those and plain text, drop anything else. */
  function excerptNodes(html: string): Node[] {
    const doc = new DOMParser().parseFromString(`<p>${html}</p>`, 'text/html');
    return Array.from(doc.body.firstChild!.childNodes).map((n) => {
      if (n.nodeName === 'MARK') {
        const mark = document.createElement('mark');
        mark.textContent = curly(n.textContent ?? '');
        return mark;
      }
      return document.createTextNode(curly(n.textContent ?? ''));
    });
  }

  async function run(query: string) {
    if (!status || !list) return;
    const id = ++latest;
    const q = query.trim();
    const url = new URL(location.href);
    if (q) url.searchParams.set('q', q);
    else url.searchParams.delete('q');
    history.replaceState(null, '', url);
    if (!q) {
      list.replaceChildren();
      status.textContent = '';
      return;
    }
    try {
      const path = '/pagefind/pagefind.js';
      pagefind ??= import(/* @vite-ignore */ path) as Promise<Pagefind>;
      const pf = await pagefind;
      const found = await pf.search(q);
      const data = await Promise.all(found.results.slice(0, 20).map((r) => r.data()));
      if (id !== latest) return; // a newer query has started
      list.replaceChildren(
        ...data.map((d) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = d.url;
          a.textContent = curly(d.meta.title ?? d.url);
          const p = document.createElement('p');
          p.append(...excerptNodes(d.excerpt));
          li.append(a, p);
          return li;
        }),
      );
      status.textContent = data.length
        ? (status.dataset.results ?? '').replace('{n}', String(found.results.length))
        : (status.dataset.none ?? '').replace('{q}', q);
    } catch {
      status.textContent = status.dataset.error ?? '';
    }
  }

  if (form && input) {
    let timer: number | undefined;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      run(input.value);
    });
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => run(input.value), 250);
    });
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) {
      input.value = initial;
      run(initial);
    }
  }
</script>

<style>
  .search-page { max-width: 52rem; }
  .search-form label { display: block; font-weight: 700; color: var(--navy-900); margin-bottom: var(--space-1); }
  .search-row { display: flex; gap: var(--space-1); }
  .search-row input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    padding: 0.5rem 0.875rem;
    border: 2px solid var(--grey-600);
    border-radius: var(--radius);
    font: inherit;
    color: var(--ink);
    background: var(--white);
  }
  .search-row input:focus-visible { border-color: var(--blue-700); }
  .search-status { margin-block: var(--space-3) var(--space-2); font-weight: 700; color: var(--grey-600); }
  .search-status:empty { margin: 0; }
  .search-results { display: grid; gap: var(--space-2); }
  .search-results :global(li) { margin: 0; padding-block: var(--space-2); border-bottom: 1px solid var(--grey-200); }
  .search-results :global(a) { font: 700 1.1875rem/1.4 var(--font-serif); }
  :global(:lang(ar)) .search-results :global(a) { font-family: var(--font-ar-serif); }
  .search-results :global(p) { margin: 0.25rem 0 0; color: var(--grey-600); }
  .search-results :global(mark) { background: var(--ochre-50); color: var(--ink); font-weight: 700; padding: 0 0.1em; }
  .all-pages { margin-top: var(--space-5); padding-top: var(--space-3); border-top: 1px solid var(--grey-200); }
  .all-pages h2 { font-size: var(--fs-h3); }
  .all-pages ul { columns: 2 14rem; column-gap: var(--space-4); }
  .all-pages li { break-inside: avoid; margin: 0 0 0.5rem; }
</style>
