---
import FactStrip from '../components/FactStrip.astro';
import Icon from '../components/Icon.astro';
import { content } from '../content';
import { pagePath, type Lang, type PageKey } from '../i18n/routes';
import { site } from '../config/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = content[lang];
const a = c.about;
const next: PageKey[] = ['principles', 'framework', 'governance', 'transparency'];
---

<div class="page-body">
  <div class="container layout-aside">
    <div class="prose">
      <!-- Art. 1–3 and preamble: history and continuity -->
      <h2>{a.storyTitle}</h2>
      {a.story.map((p) => <p>{p}</p>)}

      <ol class="timeline plain-list">
        {
          a.timeline.map((e) => (
            <li>
              <p class="timeline-date">{e.date}</p>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </li>
          ))
        }
      </ol>

      <!-- Art. 5: vision and mission -->
      <h2>{a.visionTitle}</h2>
      <blockquote class="vision">{a.vision}</blockquote>

      <h2>{a.missionTitle}</h2>
      <ul class="checklist">{a.mission.map((m) => <li>{m}</li>)}</ul>
    </div>

    <aside class="aside-stack">
      <div class="aside-box">
        <h2>{a.namesTitle}</h2>
        <p>{a.namesText}</p>
        <ul class="names">
          <li lang="en"><strong>{site.legalName}</strong> <span>({site.acronym})</span></li>
          <li lang="fr"><strong>{site.nameFr}</strong> <span>({site.acronymFr})</span></li>
          <li lang="ar" dir="rtl"><strong>{site.nameAr}</strong></li>
        </ul>
      </div>
      <nav class="aside-box" aria-labelledby="about-next">
        <h2 id="about-next">{a.nextTitle}</h2>
        <ul class="next-links">
          {next.map((key) => <li><a href={pagePath(lang, key)}>{c.nav[key]}<Icon name="arrow" size={16} flip /></a></li>)}
        </ul>
      </nav>
    </aside>
  </div>
  <div class="container fact-gap">
    <FactStrip lang={lang} />
  </div>
</div>

<style>
  .timeline { margin-block: var(--space-4) var(--space-5); border-inline-start: 2px solid var(--grey-200); }
  .timeline li { position: relative; padding-inline-start: var(--space-3); padding-bottom: var(--space-3); }
  .timeline li::before {
    content: '';
    position: absolute;
    inset-inline-start: -0.5625rem;
    top: 0.3rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--white);
    border: 3px solid var(--blue-700);
  }
  .timeline-date { margin: 0; font-size: var(--fs-small); font-weight: 700; color: var(--blue-700); }
  .timeline h3 { font-size: 1.25rem; margin-bottom: 0.25rem; }
  .timeline p:last-child { margin: 0; color: var(--grey-600); }
  .vision {
    margin: 0 0 var(--space-3);
    padding: var(--space-3);
    border-inline-start: 4px solid var(--ochre-500);
    background: var(--grey-50);
    font: 700 var(--fs-h3)/1.5 var(--font-serif);
    color: var(--navy-900);
  }
  :global(:lang(ar)) .vision { font-family: var(--font-ar-serif); }
  .aside-stack { display: grid; gap: var(--space-3); align-content: start; }
  .names li { padding-block: 0.5rem; border-bottom: 1px solid var(--grey-200); }
  .names li[lang='ar'] { font-family: var(--font-ar-system); text-align: start; }
  :global(html[lang='ar']) .names li[lang='ar'] { font-family: var(--font-ar-sans); }
  .names span { color: var(--grey-600); }
  .next-links a { display: flex; justify-content: space-between; align-items: center; padding-block: 0.5rem; font-weight: 500; }
  .fact-gap { margin-top: var(--space-5); }
</style>
