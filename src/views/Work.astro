---
import ObjectiveIcon from '../components/ObjectiveIcon.astro';
import ArtRef from '../components/ArtRef.astro';
import WithToc from '../components/WithToc.astro';
import { content } from '../content';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = content[lang];
const w = c.work;
---

<!-- Art. 6: objectives -->
<div class="page-body">
  <div class="container">
    <WithToc lang={lang} items={c.objectives.map((o) => ({ id: o.id, label: o.title }))}>
      <div class="prose">{w.intro.map((p) => <p class="lead">{p}</p>)}</div>
      {
        c.objectives.map((o, i) => (
          <section class="objective" id={o.id} aria-labelledby={`${o.id}-title`}>
            <div class="objective-head">
              <ObjectiveIcon id={o.id} size={56} />
              <div>
                <ArtRef lang={lang} article={`6.${i + 1}`} />
                <h2 id={`${o.id}-title`}>{o.title}</h2>
              </div>
            </div>
            <div class="prose">
              {o.body.map((p) => <p>{p}</p>)}
              <h3>{w.pointsTitle}</h3>
              <ul class="checklist">{o.points.map((pt) => <li>{pt}</li>)}</ul>
            </div>
          </section>
        ))
      }
      <aside class="aside-box" slot="aside" aria-labelledby="method-title">
        <h2 id="method-title">{w.methodTitle}</h2>
        {w.method.map((p) => <p>{p}</p>)}
      </aside>
    </WithToc>
  </div>
</div>

<style>
  .objective { padding-block: var(--space-5) var(--space-3); border-bottom: 1px solid var(--grey-200); }
  .objective:last-child { border-bottom: 0; }
  .objective-head { display: flex; gap: var(--space-3); align-items: center; margin-bottom: var(--space-3); color: var(--blue-700); }
  .objective-head h2 { margin: var(--space-1) 0 0; }
  .aside-box :global(p:last-child) { margin-bottom: 0; }
</style>
