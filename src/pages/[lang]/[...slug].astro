---
import Base from '../../layouts/Base.astro';
import Home from '../../views/Home.astro';
import About from '../../views/About.astro';
import Principles from '../../views/Principles.astro';
import Framework from '../../views/Framework.astro';
import Work from '../../views/Work.astro';
import Advocacy from '../../views/Advocacy.astro';
import Governance from '../../views/Governance.astro';
import Transparency from '../../views/Transparency.astro';
import News from '../../views/News.astro';
import Involved from '../../views/Involved.astro';
import Contact from '../../views/Contact.astro';
import Sections from '../../views/Sections.astro';
import ArticleView from '../../views/Article.astro';
import PageHeader from '../../components/PageHeader.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { content } from '../../content';
import { ui } from '../../i18n/ui';
import { languages, pageKeys, slugs, type Lang, type PageKey } from '../../i18n/routes';
import { PAGE_SIZE, allArticles, articleAlternates, articleLang, articleSlug, articleTranslations, formatDate, newsPagePath, readingMinutes, readingTimeLabel, type Article } from '../../lib/news';
import { categoryLabel } from '../../lib/categories';

type Listing = { articles: Article[]; page: number; totalPages: number };
type Props =
  | { kind: 'page'; lang: Lang; pageKey: PageKey; news?: Listing; altPaths?: Record<Lang, string>; hreflangPaths?: Partial<Record<Lang, string>> }
  | { kind: 'article'; lang: Lang; pageKey: 'news'; article: Article; related: Article[]; newer?: Article; older?: Article; altPaths: Record<Lang, string>; hreflangPaths: Partial<Record<Lang, string>> };

export async function getStaticPaths() {
  const articles = await allArticles();
  const pageCount = (l: Lang) => Math.max(1, Math.ceil(articles.filter((a) => articleLang(a) === l).length / PAGE_SIZE));
  const totals = Object.fromEntries(languages.map((l) => [l, pageCount(l)])) as Record<Lang, number>;
  return languages.flatMap((lang) => {
    const own = articles.filter((a) => articleLang(a) === lang);
    const totalPages = totals[lang];
    const newsSlug = slugs[lang].news;

    const pages = pageKeys.map((key) => ({
      params: { lang, slug: slugs[lang][key] || undefined },
      props: {
        kind: 'page' as const,
        lang,
        pageKey: key,
        ...(key === 'news' ? { news: { articles: own.slice(0, PAGE_SIZE), page: 1, totalPages } } : {}),
        ...(key === 'home' ? { news: { articles: own.slice(0, 3), page: 1, totalPages: 1 } } : {}),
      },
    }));
    const listing = Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((page) => ({
      params: { lang, slug: `${newsSlug}/page/${page}` },
      props: {
        kind: 'page' as const,
        lang,
        pageKey: 'news' as const,
        news: { articles: own.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE), page, totalPages },
        // Another language may have fewer pages: the switcher falls back to its last page,
        // and hreflang lists only languages that really have this page.
        altPaths: Object.fromEntries(languages.map((l) => [l, newsPagePath(l, Math.min(page, totals[l]))])) as Record<Lang, string>,
        hreflangPaths: Object.fromEntries(languages.filter((l) => totals[l] >= page).map((l) => [l, newsPagePath(l, page)])),
      },
    }));
    // `own` is newest first, so the newer article is the previous entry and the older one the next.
    const items = own.map((article, i) => ({
      params: { lang, slug: `${newsSlug}/${articleSlug(article)}` },
      props: {
        kind: 'article' as const,
        lang,
        pageKey: 'news' as const,
        article,
        related: own.filter((a) => a !== article).slice(0, 2),
        newer: own[i - 1],
        older: own[i + 1],
        altPaths: articleAlternates(article, articles),
        hreflangPaths: articleTranslations(article, articles),
      },
    }));
    return [...pages, ...listing, ...items];
  });
}

const props = Astro.props;
const { lang, pageKey } = props;
const c = content[lang];
const t = ui[lang];
const meta = c.meta[pageKey];

const views = {
  about: About,
  principles: Principles,
  framework: Framework,
  work: Work,
  advocacy: Advocacy,
  governance: Governance,
  transparency: Transparency,
  involved: Involved,
  contact: Contact,
} as const;
const View = pageKey in views ? views[pageKey as keyof typeof views] : null;
---

{
  props.kind === 'article' ? (
    <Base
      lang={lang}
      pageKey="news"
      title={props.article.data.title.length > 50 ? `${props.article.data.title.slice(0, 48)}…` : props.article.data.title}
      description={props.article.data.description}
      altPaths={props.altPaths}
      hreflangPaths={props.hreflangPaths}
      ogType="article"
      noindex={props.article.data.draft}
    >
      <PageHeader lang={lang} pageKey="news" title={props.article.data.title} lead="" currentCrumb={props.article.data.title}>
        <p class="article-meta">
          <span>{categoryLabel(props.article.data.category, lang)}</span> ·{' '}
          <span>{t.publishedOn} <time datetime={props.article.data.date.toISOString().slice(0, 10)}>{formatDate(props.article.data.date, lang)}</time></span> ·{' '}
          <span>{readingTimeLabel(readingMinutes(props.article), lang)}</span>
        </p>
      </PageHeader>
      <ArticleView lang={lang} article={props.article} related={props.related} newer={props.newer} older={props.older} />
    </Base>
  ) : (
    <Base
      lang={lang}
      pageKey={pageKey}
      title={props.news && props.news.page > 1 && pageKey === 'news' ? `${meta.title} (${props.news.page})` : meta.title}
      description={meta.description}
      altPaths={props.altPaths}
      hreflangPaths={props.hreflangPaths}
    >
      {pageKey !== 'home' && <PageHeader lang={lang} pageKey={pageKey} />}
      {pageKey === 'news' && props.news && <News lang={lang} {...props.news} />}
      {pageKey === 'home' && <Home lang={lang} latest={props.news?.articles ?? []} />}
      {View && <View lang={lang} />}
      {pageKey === 'legal' && <Sections lang={lang} sections={c.legal.sections} />}
      {pageKey === 'privacy' && <Sections lang={lang} sections={c.privacy.sections} updated={c.privacy.updated} />}
      {pageKey !== 'home' && <RelatedLinks lang={lang} pageKey={pageKey} />}
    </Base>
  )
}

<style>
  .article-meta { margin: var(--space-2) 0 0; color: rgb(255 255 255 / 0.9); font-size: var(--fs-small); }
</style>
