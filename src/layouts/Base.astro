---
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuickExit from '../components/QuickExit.astro';
import { languages, langMeta, pagePath, type Lang, type PageKey } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { site } from '../config/site';
import { jsClassScript } from '../config/inline-scripts.mjs';
// Preloading the heading font keeps the largest text from being repainted late.
import headingFontLatin from '@fontsource/merriweather/files/merriweather-latin-900-normal.woff2?url';
import headingFontArabic from '@fontsource/noto-naskh-arabic/files/noto-naskh-arabic-arabic-700-normal.woff2?url';

interface Props {
  lang: Lang;
  /** Null for pages that exist outside the translated page set (404). */
  pageKey: PageKey | null;
  title: string;
  description: string;
  noindex?: boolean;
  /** Where the language switcher goes, for pages outside the fixed page set (news articles, listing pages). */
  altPaths?: Record<Lang, string> | undefined;
  /** The URLs that really are this page in another language, for hreflang. Defaults to altPaths. */
  hreflangPaths?: Partial<Record<Lang, string>> | undefined;
  ogType?: 'website' | 'article';
}

const { lang, pageKey, title, description, noindex = false, altPaths, hreflangPaths, ogType = 'website' } = Astro.props;
const meta = langMeta[lang];
const t = ui[lang];
const siteUrl = Astro.site ?? new URL('https://www.acjr.org');
const abs = (path: string) => new URL(path, siteUrl).href;

// Pagefind indexes only <main> of pages meant to be found: not drafts, the 404, the styleguide or the search page.
const searchable = !noindex && pageKey !== null && pageKey !== 'search';
const fullTitle = pageKey === 'home' ? `ACJR — ${title}` : `${title} | ACJR`;
const pathFor = (l: Lang) => altPaths?.[l] ?? (pageKey ? pagePath(l, pageKey) : undefined);
const canonical = pageKey ? abs(pathFor(lang)!) : undefined;
// hreflang lists only real translations; a page with no translation gets none.
const hreflangFor = (l: Lang) => (hreflangPaths ? hreflangPaths[l] : pathFor(l));
const translated = pageKey ? languages.filter((l) => hreflangFor(l)) : [];
const alternates = translated.length > 1 ? translated.map((l) => ({ hreflang: langMeta[l].hreflang, href: abs(hreflangFor(l)!) })) : [];
// x-default is the first language (fr, en, ar) that has the page, so every page of a cluster agrees.
const xDefault = alternates.length ? hreflangFor(translated[0]!) : undefined;
const ogImage = abs(`/brand/og-image-${lang}.png`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: site.legalName,
  alternateName: [site.nameFr, site.nameAr, site.acronym, site.acronymFr],
  url: abs(`/${lang}/`),
  logo: abs('/brand/mark.svg'),
  foundingDate: site.foundingDate,
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'FR' },
  ...(site.email ? { email: site.email } : {}),
};
---

<!doctype html>
<html lang={lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={jsClassScript} />
    <link rel="preload" href={lang === 'ar' ? headingFontArabic : headingFontLatin} as="font" type="font/woff2" crossorigin />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* The safety exit leaves by script too; no-referrer keeps the neutral site from learning where the visitor came from. */}
    {pageKey === 'contact' && <meta name="referrer" content="no-referrer" />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={abs(xDefault)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b2545" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={meta.ogLocale} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    {/* Second in the Tab order on the Contact page, so the safety exit is reached at once. */}
    {pageKey === 'contact' && <QuickExit lang={lang} />}
    <Header lang={lang} pageKey={pageKey} altPaths={altPaths} />
    <main id="main" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
