{
  "name": "acjr-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:types": "astro check",
    "check:content": "node scripts/check-parity.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:html": "html-validate \"dist/**/*.html\" \"dist-drafts/**/*.html\" \"dist-fixtures/**/*.html\"",
    "check:leaks": "node scripts/check-leaks.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:external-links": "node scripts/check-links.mjs && node scripts/check-external-links.mjs",
    "test:e2e": "playwright test",
    "check": "npm run check:types && npm run check:content && npm run check:contrast && npm run build && npm run build:drafts && npm run build:fixtures && npm run check:leaks && npm run check:csp && npm run check:budgets && npm run check:html && npm run check:links && npm run test:e2e && npm run check:lighthouse",
    "build:fixtures": "node scripts/make-news-fixtures.mjs && NEWS_DIR=./.fixtures/news astro build --outDir dist-fixtures",
    "build:drafts": "SHOW_DRAFTS=1 PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/test-endpoint astro build --outDir dist-drafts",
    "check:lighthouse": "node scripts/check-lighthouse.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "html-validate": "^11.17.0",
    "lighthouse": "^12.8.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "astro": "^7.4.1"
  }
}
